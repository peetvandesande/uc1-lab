# Ignore everything by default and re-include only what the build needs.
# Re-include the source *directories by name*, not !**/*.go: BuildKit
# resolves file re-includes under a blanket **, but the legacy builder
# (no buildx, as on this workstation's colima) and Podman do not - the
# context silently loses the sources and the build fails with
# "package cmd/main.go is not in std".
**
!cmd
!api
!internal
!go.mod
!go.sum
**/*_test.go
